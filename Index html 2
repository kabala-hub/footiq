
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#142238">
<title>FOOTIQ | Football Intelligence</title>

<style>
:root {
  --navy: #142238;
  --dark: #0D1728;
  --card: #1C2D45;
  --cream: #F2EBDD;
  --muted: #B9BECA;
  --red: #C83D45;
  --border: #34445A;
  --green: #6FAF91;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: var(--dark);
  color: var(--cream);
  font-family: Arial, sans-serif;
}

header {
  padding: 22px 18px;
  background: var(--navy);
  border-bottom: 2px solid var(--red);
}

.logo {
  font-size: 27px;
  font-weight: 900;
  letter-spacing: 2px;
}

.logo span {
  color: var(--red);
}

.subtitle {
  color: var(--muted);
  font-size: 11px;
  letter-spacing: 2px;
  margin-top: 5px;
}

main {
  width: 100%;
  max-width: 650px;
  margin: auto;
  padding: 18px 15px 40px;
}

.section-title {
  font-size: 18px;
  margin: 10px 0 15px;
}

.card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 15px;
  padding: 18px;
  margin-bottom: 16px;
}

.tag {
  color: var(--red);
  font-size: 10px;
  font-weight: bold;
  letter-spacing: 2px;
  text-transform: uppercase;
}

.match {
  display: flex;
  align-items: center;
  justify-content: space-around;
  text-align: center;
  margin: 22px 0;
  gap: 10px;
}

.team {
  flex: 1;
  min-width: 0;
}

.team-name {
  font-size: 17px;
  font-weight: bold;
  overflow-wrap: anywhere;
}

.team-label {
  color: var(--muted);
  font-size: 10px;
  margin-top: 6px;
}

.vs {
  color: var(--red);
  font-weight: bold;
  font-size: 15px;
}

label {
  display: block;
  font-size: 12px;
  color: var(--muted);
  margin: 13px 0 6px;
}

input {
  width: 100%;
  background: var(--dark);
  color: var(--cream);
  border: 1px solid var(--border);
  border-radius: 9px;
  padding: 12px;
  font-size: 15px;
  outline: none;
}

input:focus {
  border-color: var(--red);
}

input::placeholder {
  color: #79869A;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.team-heading {
  font-size: 13px;
  font-weight: bold;
  margin: 18px 0 5px;
  color: var(--cream);
}

button {
  width: 100%;
  border: none;
  background: var(--red);
  color: white;
  padding: 15px;
  font-size: 14px;
  font-weight: bold;
  border-radius: 10px;
  margin-top: 20px;
  cursor: pointer;
}

button:active {
  transform: scale(.98);
}

button.secondary {
  background: transparent;
  border: 1px solid var(--border);
  color: var(--cream);
  margin-top: 10px;
}

.help {
  color: var(--muted);
  font-size: 11px;
  line-height: 1.6;
  margin-top: 12px;
}

.results {
  display: none;
}

.result-score {
  text-align: center;
  font-size: 35px;
  font-weight: bold;
  margin: 15px 0;
}

.result-caption {
  text-align: center;
  color: var(--muted);
  font-size: 11px;
}

.probability {
  margin: 17px 0;
}

.probability-top {
  display: flex;
  justify-content: space-between;
  font-size: 13px;
  margin-bottom: 7px;
  gap: 8px;
}

.bar {
  height: 9px;
  background: var(--dark);
  border-radius: 20px;
  overflow: hidden;
}

.fill {
  height: 100%;
  background: var(--red);
  border-radius: 20px;
}

.fill.green {
  background: var(--green);
}

.fill.cream {
  background: var(--cream);
}

.metrics {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  margin-top: 15px;
}

.metric {
  background: var(--dark);
  padding: 14px;
  border-radius: 10px;
}

.metric-value {
  font-size: 22px;
  font-weight: bold;
  margin-top: 8px;
}

.metric-label {
  font-size: 11px;
  color: var(--muted);
}

.score-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 12px;
}

.score-item {
  background: var(--dark);
  padding: 10px 13px;
  border-radius: 8px;
  font-weight: bold;
  font-size: 13px;
}

.notice {
  background: rgba(200,61,69,.10);
  border: 1px solid rgba(200,61,69,.4);
  border-radius: 10px;
  padding: 12px;
  color: var(--muted);
  font-size: 11px;
  line-height: 1.6;
  margin-top: 15px;
}

footer {
  text-align: center;
  padding: 20px;
  color: var(--muted);
  font-size: 10px;
  border-top: 1px solid var(--border);
}

@media (max-width: 380px) {
  .team-name { font-size: 14px; }
  .card { padding: 14px; }
}
</style>
</head>

<body>

<header>
  <div class="logo">FOOT<span>IQ</span></div>
  <div class="subtitle">FOOTBALL INTELLIGENCE</div>
</header>

<main>

  <div class="card">
    <div class="tag">Match center</div>

    <div class="match">
      <div class="team">
        <div class="team-name" id="homeDisplay">Arsenal</div>
        <div class="team-label">DOMICILE</div>
      </div>

      <div class="vs">VS</div>

      <div class="team">
        <div class="team-name" id="awayDisplay">Chelsea</div>
        <div class="team-label">EXTÉRIEUR</div>
      </div>
    </div>

    <div class="grid">
      <div>
        <label>Équipe domicile</label>
        <input id="homeName" value="Arsenal" maxlength="30">
      </div>
      <div>
        <label>Équipe extérieure</label>
        <input id="awayName" value="Chelsea" maxlength="30">
      </div>
    </div>
  </div>

  <div class="card">
    <div class="tag">Analyse statistique</div>
    <h2 class="section-title">Données du match</h2>

    <p class="team-heading">ÉQUIPE DOMICILE</p>

    <div class="grid">
      <div>
        <label>Buts marqués / match</label>
        <input type="number" id="homeGF" placeholder="Ex : 1.8"
        min="0" max="10" step="0.1">
      </div>

      <div>
        <label>Buts encaissés / match</label>
        <input type="number" id="homeGA" placeholder="Ex : 0.9"
        min="0" max="10" step="0.1">
      </div>
    </div>

    <p class="team-heading">ÉQUIPE EXTÉRIEURE</p>

    <div class="grid">
      <div>
        <label>Buts marqués / match</label>
        <input type="number" id="awayGF" placeholder="Ex : 1.4"
        min="0" max="10" step="0.1">
      </div>

      <div>
        <label>Buts encaissés / match</label>
        <input type="number" id="awayGA" placeholder="Ex : 1.2"
        min="0" max="10" step="0.1">
      </div>
    </div>

    <div class="help">
      Utilise les moyennes de buts marqués et encaissés par match,
      idéalement sur une période récente et comparable.
    </div>

    <button onclick="analyzeMatch()">
      LANCER L'ANALYSE
    </button>
  </div>

  <div class="results" id="results">

    <div class="card">
      <div class="tag">Prédiction FOOTIQ</div>
      <h2 class="section-title">Résultat probable</h2>

      <div class="result-score" id="bestScore">1 - 1</div>
      <div class="result-caption">Score exact le plus probable</div>

      <div class="metrics">
        <div class="metric">
          <div class="metric-label">Buts attendus domicile</div>
          <div class="metric-value" id="homeXG">0.00</div>
        </div>
        <div class="metric">
          <div class="metric-label">Buts attendus extérieur</div>
          <div class="metric-value" id="awayXG">0.00</div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="tag">Probabilités</div>
      <h2 class="section-title">1X2</h2>

      <div class="probability">
        <div class="probability-top">
          <span id="homeLabel">Arsenal gagne (1)</span>
          <strong id="pHome">0%</strong>
        </div>
        <div class="bar">
          <div class="fill" id="barHome"></div>
        </div>
      </div>

      <div class="probability">
        <div class="probability-top">
          <span>Match nul (X)</span>
          <strong id="pDraw">0%</strong>
        </div>
        <div class="bar">
          <div class="fill cream" id="barDraw"></div>
        </div>
      </div>

      <div class="probability">
        <div class="probability-top">
          <span id="awayLabel">Chelsea gagne (2)</span>
          <strong id="pAway">0%</strong>
        </div>
        <div class="bar">
          <div class="fill green" id="barAway"></div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="tag">Marchés de buts</div>
      <h2 class="section-title">Autres probabilités</h2>

      <div class="probability">
        <div class="probability-top">
          <span>Plus de 2,5 buts</span>
          <strong id="over25">0%</strong>
        </div>
        <div class="bar">
          <div class="fill" id="barOver"></div>
        </div>
      </div>

      <div class="probability">
        <div class="probability-top">
          <span>Moins de 2,5 buts</span>
          <strong id="under25">0%</strong>
        </div>
        <div class="bar">
          <div class="fill cream" id="barUnder"></div>
        </div>
      </div>

      <div class="probability">
        <div class="probability-top">
          <span>Les deux équipes marquent</span>
          <strong id="btts">0%</strong>
        </div>
        <div class="bar">
          <div class="fill green" id="barBTTS"></div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="tag">Simulation</div>
      <h2 class="section-title">Scores exacts probables</h2>
      <div class="score-list" id="scoreList"></div>

      <div class="notice">
        Les résultats sont des estimations mathématiques fondées sur
        les statistiques saisies. Ils ne garantissent pas le résultat
        réel d'un match.
      </div>

      <button class="secondary" onclick="resetAnalysis()">
        NOUVELLE ANALYSE
      </button>
    </div>

  </div>

</main>

<footer>
  FOOTIQ © 2026 — FOOTBALL INTELLIGENCE<br>
  Outil statistique expérimental
</footer>

<script>
const $ = id => document.getElementById(id);

function poisson(lambda, k) {
  let fact = 1;
  for (let i = 2; i <= k; i++) fact *= i;
  return Math.exp(-lambda) * Math.pow(lambda, k) / fact;
}

function percent(value) {
  return (value * 100).toFixed(1) + "%";
}

function setProbability(valueId, barId, value) {
  $(valueId).textContent = percent(value);
  $(barId).style.width = Math.min(100, value * 100) + "%";
}

function analyzeMatch() {
  const home = $("homeName").value.trim() || "Domicile";
  const away = $("awayName").value.trim() || "Extérieur";

  const hGF = Number($("homeGF").value);
  const hGA = Number($("homeGA").value);
  const aGF = Number($("awayGF").value);
  const aGA = Number($("awayGA").value);

  const fields = ["homeGF", "homeGA", "awayGF", "awayGA"];

  for (const id of fields) {
    const value = $(id).value;
    if (value === "" || !Number.isFinite(Number(value)) ||
        Number(value) < 0 || Number(value) > 10) {
      alert("Remplis les quatre statistiques avec des valeurs entre 0 et 10.");
      return;
    }
  }

  const homeXG = (hGF + aGA) / 2;
  const awayXG = (aGF + hGA) / 2;

  const maxGoals = 10;
  const homeP = [];
  const awayP = [];

  for (let i = 0; i <= maxGoals; i++) {
    homeP[i] = poisson(homeXG, i);
    awayP[i] = poisson(awayXG, i);
  }

  let winHome = 0;
  let draw = 0;
  let winAway = 0;
  let over = 0;
  let btts = 0;
  let scores = [];

  for (let h = 0; h <= maxGoals; h++) {
    for (let a = 0; a <= maxGoals; a++) {
      const p = homeP[h] * awayP[a];

      if (h > a) winHome += p;
      else if (h === a) draw += p;
      else winAway += p;

      if (h + a > 2) over += p;
      if (h > 0 && a > 0) btts += p;

      scores.push({
        score: h + " - " + a,
        probability: p
      });
    }
  }

  scores.sort((a, b) => b.probability - a.probability);

  const total = winHome + draw + winAway;
  winHome /= total;
  draw /= total;
  winAway /= total;

  const under = 1 - over;
  const both = btts;

  $("homeDisplay").textContent = home;
  $("awayDisplay").textContent = away;
  $("homeLabel").textContent = home + " gagne (1)";
  $("awayLabel").textContent = away + " gagne (2)";

  $("homeXG").textContent = homeXG.toFixed(2);
  $("awayXG").textContent = awayXG.toFixed(2);

  $("bestScore").textContent = scores[0].score;

  setProbability("pHome", "barHome", winHome);
  setProbability("pDraw", "barDraw", draw);
  setProbability("pAway", "barAway", winAway);
  setProbability("over25", "barOver", over);
  setProbability("under25", "barUnder", under);
  setProbability("btts", "barBTTS", both);

  $("scoreList").innerHTML = "";

  scores.slice(0, 5).forEach(item => {
    const el = document.createElement("div");
    el.className = "score-item";
    el.textContent = item.score + " · " + percent(item.probability);
    $("scoreList").appendChild(el);
  });

  $("results").style.display = "block";
  $("results").scrollIntoView({ behavior: "smooth" });
}

function resetAnalysis() {
  $("results").style.display = "none";
  $("homeGF").value = "";
  $("homeGA").value = "";
  $("awayGF").value = "";
  $("awayGA").value = "";
  window.scrollTo({ top: 0, behavior: "smooth" });
}

$("homeName").addEventListener("input", () => {
  $("homeDisplay").textContent = $("homeName").value || "Domicile";
});

$("awayName").addEventListener("input", () => {
  $("awayDisplay").textContent = $("awayName").value || "Extérieur";
});
</script>

</body>
</html>
